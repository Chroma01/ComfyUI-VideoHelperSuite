{
    "main_pass":
    [
        "-n", "-c:v", "libx265",
        "-vtag", "hvc1",
        "-pix_fmt", "yuv420p10le",
        "-crf", ["crf","INT", {"default": 28, "min": 20, "max": 40, "step": 1}],
        "-preset", "slow",
        "-x265-params", "log-level=quiet:aq-mode=3",
        "-vf", "scale=out_color_matrix=bt709",
        "-color_range", "tv", "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709"
    ],
    "fake_trc": "bt709",
    "audio_pass": ["-c:a", "aac", "-b:a", "192k", "-movflags", "use_metadata_tags"],
    "save_metadata": ["save_metadata", "BOOLEAN", {"default": true}],
    "extension": "mp4"
}